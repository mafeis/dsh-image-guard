{
  "name": "dsh-image-guard",
  "version": "0.8.6",
  "description": "DeepSeek Harness plugin: trims historical images from requests to the provider image budget and retries with fewer images when the provider rejects the image count with HTTP 400. · DSH 插件：发送前将历史图片裁剪至预算内，并在上游因图片数量返回 400 时自动降级重试。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "image",
    "images",
    "multimodal",
    "vision",
    "limit-mm-per-prompt",
    "vllm",
    "context",
    "guard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafeis/dsh-image-guard.git"
  },
  "homepage": "https://github.com/mafeis/dsh-image-guard",
  "bugs": {
    "url": "https://github.com/mafeis/dsh-image-guard/issues"
  },
  "scripts": {
    "test": "node tests/units.test.mjs && node tests/guard.test.mjs && node tests/shapes.test.mjs && node tests/abort.test.mjs && node tests/client.test.mjs && node tests/marker.test.mjs && node tests/selfcheck.test.mjs",
    "lint": "eslint ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
