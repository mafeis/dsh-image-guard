{
  "name": "dsh-image-guard",
  "version": "0.8.12",
  "description": "DeepSeek Harness plugin: trims the oldest images from outgoing chat requests and, when the provider rejects the image count with HTTP 400, parses the limit from the error and retries with fewer images. · DSH 插件：裁剪即将发出请求中的历史图片，并在上游因图片数量返回 400 时解析该上限并按更少的图片重试。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "image",
    "images",
    "multimodal",
    "vision",
    "limit-mm-per-prompt",
    "vllm",
    "context",
    "guard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafeis/dsh-image-guard.git"
  },
  "homepage": "https://github.com/mafeis/dsh-image-guard",
  "bugs": {
    "url": "https://github.com/mafeis/dsh-image-guard/issues"
  },
  "scripts": {
    "test": "node tests/units.test.mjs && node tests/guard.test.mjs && node tests/shapes.test.mjs && node tests/abort.test.mjs && node tests/client.test.mjs && node tests/marker.test.mjs && node tests/selfcheck.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <3.19.0 || >=3.19.0-rc.1 <4.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
